NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# --- WhatsApp Cloud API (Meta) ---
# Pick any random string for the verify token; you type the same value into Meta's webhook form.
WHATSAPP_VERIFY_TOKEN=
# Meta App Dashboard > App settings > Basic > App secret
WHATSAPP_APP_SECRET=
# Use a system-user token for anything beyond the first quick test (temporary tokens expire quickly)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0

# --- AI triage (Gemini first, OpenAI as fallback) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER_ORDER=gemini,openai
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash
OPENAI_MODELS=gpt-4o-mini

# --- Admin access (single prototype admin; no signup) ---
# SESSION_SECRET must be at least 32 random characters
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: store data somewhere other than ./.data
# DATA_DIR=

# Number people message on WhatsApp (digits only, no +); used for wa.me links on the website
WHATSAPP_BOT_NUMBER=

# --- Database and file storage (hosted) ---
# Leave DATABASE_URL empty for local development: a built-in local database is used instead.
# Supabase: Connect > Transaction pooler connection string (port 6543), with your password filled in.
DATABASE_URL=
# Supabase: Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=civicos-media
# 64 hex characters (generate with: openssl rand -hex 32). Encrypts phone numbers at rest.
PHONE_ENCRYPTION_KEY=
# Set to 1 only while debugging on your own computer: prints raw WhatsApp payloads (contain phone numbers)
WEBHOOK_DEBUG=
